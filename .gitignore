# Publish submission materials, documentation, and the repository README.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Document/
!/Lab01_23127005_23127028_23127183_23127536_23127042/

# Python caches and local tooling, including inside the allowed directories.
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local archives and LaTeX build intermediates; keep PDF and test evidence.
*.zip
/Document/**/*.aux
/Document/**/*.log
/Document/**/*.out
/Document/**/*.toc
/Document/**/*.lof
/Document/**/*.lot
/Document/**/*.fls
/Document/**/*.fdb_latexmk
/Document/**/*.synctex.gz
